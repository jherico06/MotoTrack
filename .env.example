# ─── MOTOTRACK ENVIRONMENT VARIABLES ──────────────────────────────────────────
# Copy this file to `.env` and fill in your own values. Only variables prefixed
# with EXPO_PUBLIC_ are inlined into the client bundle.

# App
EXPO_PUBLIC_APP_NAME=MotoTrack

# Supabase (URL + anon publishable key are loaded via EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin security (KEEP THIS SECRET. Better: enforce server-side.)
EXPO_PUBLIC_ADMIN_SECRET_KEY=ADMIN2026
EXPO_PUBLIC_ADMIN_DEFAULT_PIN=2026
EXPO_PUBLIC_ADMIN_EMAIL=admin@mototrack.com

# Google Gemini AI (lab only - do not ship real keys in a public client)
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# GCash sandbox credentials
EXPO_PUBLIC_GCASH_MERCHANT_ID=MOTOTRACK-GRABPAY-DEMO
EXPO_PUBLIC_GCASH_CLIENT_KEY=gcash-sandbox-key

# Demo one-click logins on the Sign In screen (set to false in production)
EXPO_PUBLIC_ENABLE_DEMO_LOGINS=true

# Currency
EXPO_PUBLIC_USD_TO_PHP_RATE=50