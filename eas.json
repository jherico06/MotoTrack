{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "MotoTrack (Dev)",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGINS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "MotoTrack (Preview)",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGINS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {},
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "MotoTrack",
        "EXPO_PUBLIC_ENABLE_DEMO_LOGINS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

