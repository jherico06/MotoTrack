# Google AI Studio / Gemini API key (required)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=8787
HOST=0.0.0.0

# Optional model overrides
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
IMAGEN_MODEL=imagen-3.0-generate-002
# Used automatically if Imagen is unavailable/deprecated
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

# Comma-separated origins allowed by CORS (leave empty to allow all in local/dev)
CORS_ORIGINS=

# ─── Staff account OTP + credentials email (server-only secrets) ─────────────
# Never put these in EXPO_PUBLIC_* or client code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Preferred: Resend API (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=MotoTrack Security <onboarding@resend.dev>

# Or Gmail SMTP (use an App Password, not your normal Gmail password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_gmail_app_password

# Link included in staff credentials emails
APP_LOGIN_URL=http://127.0.0.1:8081

# Set true only for local testing when no email provider is configured
# (OTP is printed in the server console — never enable in production)
ALLOW_EMAIL_DEV_FALLBACK=false
