{
  "expo": {
    "name": "MotoTrack Motorparts and Accessories",
    "slug": "mototrack",
    "scheme": "mototrack",
    "owner": "maurin06",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moto.shop",
      "infoPlist": {
        "NSCameraUsageDescription": "MotoTrack riders use the camera to scan order QR codes and confirm deliveries."
      }
    },
    "android": {
      "package": "com.moto.shop",
      "permissions": ["CAMERA", "android.permission.CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "MotoTrack riders use the camera to scan order QR codes and confirm deliveries.",
          "microphonePermission": "MotoTrack does not record audio during delivery scans.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
