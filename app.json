{
  "expo": {
    "name": "D,Blockchain Motorparts and Accessories",
    "slug": "d-blockchain-motorparts",
    "scheme": "mototrack",
    "owner": "maurin06",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moto.shop"
    },
    "android": {
      "package": "com.moto.shop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
