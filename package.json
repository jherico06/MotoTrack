{
  "name": "moto",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "expo export -p web",
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "clear": "expo start -c",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "mobile": "expo start --tunnel",
    "server": "npm --prefix server run start",
    "server:dev": "npm --prefix server run dev",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"App.js\" \"index.js\"",
    "postinstall": "node scripts/patch-css-interop.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^2.23.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "expo": "58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "multer": "^2.4.0",
    "nativewind": "^4.2.7",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "^0.2.7",
    "react-native-web": "^0.21.4",
